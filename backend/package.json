{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Email job scheduler backend - BullMQ + Redis + Postgres + Ethereal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "dev:worker": "nodemon --watch src --ext ts --exec ts-node src/worker.ts",
    "build": "tsc",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@bull-board/api": "^9.9.0",
    "@bull-board/express": "^9.9.0",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
PORT=4000

# Ethereal Email (create a free test account at https://ethereal.email
# and paste the generated user/pass here)
ETHEREAL_USER=your_ethereal_user
ETHEREAL_PASS=your_ethereal_pass

# Rate limiting (all configurable, no hardcoding in code)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_DELAY_MS_BETWEEN_SENDS=2000
WORKER_CONCURRENCY=5

# Slack (optional - see README "Slack" section)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# Google OAuth (optional - see README "Google OAuth" section)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
